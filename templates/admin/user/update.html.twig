{% extends 'layouts/admin.base.html.twig' %}

{% block title('Modifier un utilisateur') %}

{% block body %}
    <div class="ui segment">

        <div class="ui form">
            {{ form_start(userForm) }}
            <div class="two fields">
                <div class="field">
                    <label for="user_firstname">Prénom</label>
                    {{ form_row(userForm.firstname) }}
                </div>

                <div class="field">
                    <label for="user_lastname">Nom de famille</label>
                    {{ form_row(userForm.lastname) }}
                </div>
            </div>

            <div class="field mb-1">
                <label>Agences</label>
                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
                    {% for child in userForm.deposits %}
                        <label class="label cursor-pointer border-2 border-base-300 rounded-box p-2 transition-all hover:bg-base-200 has-[:checked]:border-primary has-[:checked]:bg-primary/5">
                            <div class="flex items-center gap-3">
                                {{ form_widget(child, {'attr': {'class': 'checkbox checkbox-primary'}}) }}
                                <span class="label-text font-semibold">{{ child.vars.label }}</span>
                            </div>
                        </label>
                    {% endfor %}
                </div>
            </div>

            <div class="grid grid-cols-2 gap-6">
                <div class="field">
                    <label for="user_email">Email</label>
                    {{ form_row(userForm.email) }}
                </div>

                <div class="field">
                    <label for="user_password">Mot de passe</label>
                    {{ form_row(userForm.plainPassword) }}
                </div>
            </div>


            <div class="field">
                {{ component('Modal', { title: "Souhaitez-vous supprimer l'uitlisateur ?", text: "En supprimant l'utilisateur, il ne pourra plus accéder à la société.", url: path('app.admin.delete_user', {id: user.id}) }) }}
                {{ form_widget(userForm.submit, {label_html: true}) }} <button class="btn btn-error" type="button"><i class="ri ri-delete-bin-line"></i>Supprimer</button>
            </div>
            {{ form_end(userForm) }}
        </div>
    </div>
{% endblock %}
