{% extends 'layouts/admin.base.html.twig' %}

{% block title('Modifier le dépôt') %}

{% block body %}
    <div class="ui segment">
        <h1><i class="green save icon"></i>Dépôt : {{ deposit.name }}</h1>
        <br>

        <div class="ui form">
            {{ form_start(depositForm) }}
            <div class="field">
                <label for="deposit_name">Nom du dépôt</label>
                {{ form_row(depositForm.name) }}
            </div>

            <div class="four fields">
                <div class="field">
                    <label for="deposit_address1">Adresse 1</label>
                    {{ form_row(depositForm.address1) }}
                </div>

                <div class="field">
                    <label for="deposit_address2">Adresse 2</label>
                    {{ form_row(depositForm.address2) }}
                </div>

                <div class="field">
                    <label for="v_cop">Code Postal</label>
                    {{ form_row(depositForm.cop) }}
                </div>

                <div class="field">
                    <label for="deposit_city">Ville</label>
                    {{ form_row(depositForm.city) }}
                </div>
            </div>


            <div class="field">
                {{ component('Modal', { title: "Souhaitez-vous supprimer le dépôt ?", text: "En supprimant le dépôt, plus aucun utilisateur ne pourra y avoir accés, et toutes ses données seront supprimées.", url: path('app.dashboard.delete_deposit', {id: deposit.id}) }) }}
                {{ form_widget(depositForm.submit, {label_html: true}) }} <button class="ui basic red button" type="button" onclick="$('.ui.mini.modal').modal('show')"><i class="trash icon"></i>Supprimer le dépôt</button>
            </div>
            {{ form_end(depositForm) }}
        </div>
    </div>
{% endblock %}
