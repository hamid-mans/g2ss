{% extends 'layouts/admin.base.html.twig' %}

{% block title('Modifier le dépôt') %}

{% block body %}
    <div class="ui segment">
        <div class="ui form">
            {{ form_start(depositForm) }}
            <div class="field">
                <label for="deposit_name">Nom du dépôt</label>
                {{ form_row(depositForm.name) }}
            </div>

            <div class="grid grid-cols-4 gap-6">
                <div class="field">
                    <label for="deposit_address1">Adresse 1</label>
                    {{ form_row(depositForm.address1) }}
                </div>

                <div class="field">
                    <label for="deposit_address2">Adresse 2</label>
                    {{ form_row(depositForm.address2) }}
                </div>

                <div class="field">
                    <label for="v_cop">Code Postal</label>
                    {{ form_row(depositForm.cop) }}
                </div>

                <div class="field">
                    <label for="deposit_city">Ville</label>
                    {{ form_row(depositForm.city) }}
                </div>
            </div>


            <div class="field">
                {{ form_widget(depositForm.submit, {label_html: true}) }}
                <label for="modal_delete_deposit" class="btn btn-error" type="button">
                    <i class="ri ri-delete-bin-line"></i>Supprimer
                </label>

                <input type="checkbox" id="modal_delete_deposit" class="modal-toggle" />
                <div class="modal" role="dialog">
                    <div class="modal-box">
                        <div class="py-4">
                            <h3 class="text-2xl font-bold">Attention !</h3>
                            <p class="py-4">Êtes-vous sûr de supprimer ce dépôt ? L'ensemble des données seront effacées.</p>

                            <a class="btn btn-error" data-turbo="false" href="{{ path('app.admin.delete_deposit', { id: deposit.id }) }}">
                                <i class="ri ri-delete-bin-line"></i>
                                Supprimer
                            </a>
                        </div>

                    </div>
                    <label class="modal-backdrop" for="modal_delete_deposit">Close</label>
                </div>
            </div>
            {{ form_end(depositForm) }}
        </div>
    </div>
{% endblock %}
