{% extends 'layouts/admin.base.html.twig' %}

{% block title("Espace d'administration") %}

{% block body %}

    <p class="font-bold text-2xl mb-5">Liste des sociétés</p>

    <a href="{{ path('app.admin.create_company') }}" class="btn btn-primary mb-5">
        <i class="ri ri-add-line"></i>
        Nouvelle société
    </a>

    <div class="overflow-x-auto rounded-box border border-base-300 bg-base-100">
        <table class="table">
            <thead class="bg-base-200">
            <th>Société</th>
            <th>Ville</th>
            </thead>
            <tbody>
            {% for company in companies %}
                <tr class="clickable-row" data-href="{{ path('app.admin.update_company', {id: company.id}) }}">
                    <td><b>{{ company.name }}</b></td>
                    <td>{{ company.cop ~ ' ' ~ company.city }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

{% endblock %}
