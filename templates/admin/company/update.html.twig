{% extends 'layouts/admin.base.html.twig' %}

{% block title('Modifier la société : ' ~ company.name) %}

{% block body %}

        {{ form_start(companyForm) }}
        <div class="field">
            <label for="company_name">Nom de la société</label>
            {{ form_row(companyForm.name) }}
        </div>

        <div class="grid grid-cols-4 gap-6">
            <div class="field">
                <label for="company_address1">Adresse 1</label>
                {{ form_row(companyForm.address1) }}
            </div>

            <div class="field">
                <label for="company_address2">Adresse 2</label>
                {{ form_row(companyForm.address2) }}
            </div>

            <div class="field">
                <label for="company_cop">Code Postal</label>
                {{ form_row(companyForm.cop) }}
            </div>

            <div class="field">
                <label for="company_city">Ville</label>
                {{ form_row(companyForm.city) }}
            </div>
        </div>


        <div class="field">

            {{ form_widget(companyForm.submit, {label_html: true}) }}
            <label for="modal_delete_company" class="btn btn-error">
                <i class="ri ri-delete-bin-fill"></i>
                Supprimer la société
            </label>

            <input type="checkbox" id="modal_delete_company" class="modal-toggle" />
            <div class="modal" role="dialog">
                <div class="modal-box">
                    <div class="py-4">
                        <h3 class="text-2xl font-bold">Attention !</h3>
                        <p class="py-4">Êtes-vous sûr de supprimer cette société ?<br><br>
                        L'ensemble des données seront effacées (Utilisateurs, dépôts, produits, etc... Pensez à faire une sauvegarde des données.</p>

                        <a class="btn btn-error" data-turbo="false" href="{{ path('app.admin.delete_company', { id: company.id }) }}">
                            <i class="ri ri-delete-bin-line"></i>
                            Supprimer
                        </a>
                    </div>

                </div>
                <label class="modal-backdrop" for="modal_delete_company">Close</label>
            </div>
        </div>
        {{ form_end(companyForm) }}





        <p class="font-bold text-2xl mb-5 mt-5">Dépôts</p>

        <a class="btn btn-primary" href="{{ path('app.admin.create.deposit', { id: company.id }) }}">
            <i class="ri ri-add-line"></i>
            Nouveau
        </a><br><br>

        <div class="overflow-x-auto rounded-box border border-base-300 bg-base-100">
            <table class="table">
                <thead class="bg-base-200">
                    <tr>
                        <th>Nom</th>
                        <th>Adresse</th>
                        <th>Ville</th>
                    </tr>
                </thead>
                <tbody>
                {% for deposit in deposits %}
                    <tr class="clickable-row" data-href="{{ path('app.admin.update.deposit', {id: deposit.id}) }}">
                        <td>{{ deposit.name }}</td>
                        <td>{{ deposit.address2 ? deposit.address1 ~ ' | ' ~ deposit.address2 : deposit.address1 }}</td>
                        <td>{{ deposit.cop ~ ' ' ~ deposit.city }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        <p class="font-bold text-2xl mb-5 mt-5">Utilisateurs</p>

        <a  class="btn btn-primary" href="{{ path('app.admin.create_user', { id: company.id }) }}">
            <i class="ri ri-add-line"></i>
            Nouveau
            </a><br><br>

        <div class="overflow-x-auto rounded-box border border-base-300 bg-base-100">
            <table class="table">
                <thead class="bg-base-200">
                    <tr>
                        <th>Nom</th>
                        <th>Prénom</th>
                        <th>Adresse Email</th>
                        <th>Dépôts</th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in users %}
                        <tr class="clickable-row" data-href="{{ path('app.admin.update_user', {id:user.id}) }}">
                            <td>{{ user.lastname }}</td>
                            <td>{{ user.firstname }}</td>
                            <td>{{ user.email }}</td>
                            <td>
                                {% for deposit in user.deposits %}
                                    {{ deposit.name }}{% if not loop.last %} | {% endif %}
                                {% endfor %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

{% endblock %}
