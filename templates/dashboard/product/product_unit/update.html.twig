{% extends 'layouts/dashboard.base.html.twig' %}

{% block title('Numéro de série - ' ~ productUnit.serialNumber) %}

{% block topbar %}
    <div class="breadcrumbs text-lg">
        <ul>
            <li><a href="{{ path('app.dashboard.product.index') }}">Produits</a></li>
            <li><a href="{{ path('app.dashboard.product.update', { refInterne: productUnit.product.refInterne }) }}">{{ productUnit.product.refInterne }}</a></li>
            <li><a href="{{ path('app.dashboard.product.update', { refInterne: productUnit.product.refInterne, tab: 'serial' }) }}">Numéro de série</a></li>
            <li>{{ productUnit.serialNumber }}</li>
        </ul>
    </div>
{% endblock %}

{% block body %}

    <a href="{{ path('app.dashboard.product.update', { refInterne: productUnit.product.refInterne, tab: 'serial' }) }}" class="btn btn-secondary">
        <i class="ri-arrow-go-back-line"></i>
        Annuler
    </a>

    <div class="ui segment">
        <div class="ui form">
            {{ form_start(form) }}

            <div class="grid grid-cols-3 gap-6 mt-4">
                <div class="field">
                    <label for="product_unit_serialNumber">Numéro de série</label>
                    {{ form_widget(form.serialNumber) }}
                </div>

                <div class="field">
                    <label for="product_unit_buyPrice">Prix d'achat HT</label>
                    {{ form_widget(form.buyPrice) }}
                </div>

                <div class="field">
                    <label for="product_unit_deposit">Dépôt</label>
                    {{ form_widget(form.deposit) }}
                </div>
            </div>

            <div class="grid grid-cols-3">
                <div class="field">
                    <label>Date d'entrée</label>
                    {{ form_row(form.createdAt) }}
                </div>
            </div>

            <div class="field">
                <label for="product_unit_description">Commentaire</label>
                {{ form_widget(form.description) }}
            </div>

            <div class="field">
                {{ form_widget(form.submit, { label_html: true }) }}
            </div>

            {{ form_end(form) }}
        </div>
    </div>

{% endblock %}
