{% extends 'layouts/dashboard.base.html.twig' %}

{% block title('Produit : ' ~ product.refInterne) %}

{% block topbar %}
    <h1 class="ui header">Produit --> {{ product.refInterne }}</h1>
{% endblock %}

{% block body %}

    <p class="ui basic large black label">
        Qté. Stock --> {{ product.productUnits|length }}
    </p>

    <p class="ui basic large red label" title="Prix Moyen Pondéré (achat)">
        P.M.P. --> {{ pmp|number_format(2) }} €
    </p>

    <div class="ui top menu">
        <a class="item" data-tab="general">Général</a>
        <a class="item" data-tab="stock">Stock</a>
    </div>

    {% for msg in app.flashes('success') %}
        <div class="ui positive message">
            {{ msg }}
        </div>
    {% endfor %}

    <div class="ui bottom tab segment" data-tab="general">
        <div class="ui form">
            {{ form_start(form) }}

            {% if form_errors(form) %}
                <div class="ui red message">
                    {{ form_errors(form) }}
                </div>
            {% endif %}

            {{ component('Hr', { icon: 'thumbtack', text: 'Informations principales' }) }}

            <div class="three fields">
                <div class="field">
                    <label for="product_refInterne">Référence Interne</label>
                    {{ form_widget(form.refInterne) }}
                </div>

                <div class="field">
                    <label for="product_refSupplier">Référence Fournisseur</label>
                    {{ form_widget(form.refSupplier) }}
                </div>

                <div class="field">
                    <label for="product_category">Catégorie</label>
                    {{ form_widget(form.category) }}
                </div>
            </div>

            <div class="field">
                <label for="product_designation">Désignation</label>
                {{ form_row(form.designation) }}
            </div>

            <div class="space"></div>

            {{ component('Hr', { icon: 'euro sign', text: 'Tarification' }) }}

            <div class="five fields">
                <div class="field">
                    <label for="product_sellPrice">Prix de vente HT</label>
                    {{ form_row(form.sellPrice) }}
                </div>

                <div class="field">
                    <label>Marge estimée</label>
                    <input type="text" value="{{ (product.sellPrice - pmp)|number_format(2) }} €" disabled>
                </div>
            </div>

            <div class="field">
                <label for="product_description">Commentaire</label>
                {{ form_row(form.description) }}
            </div>

            <div class="field">
                {{ form_widget(form.submit, { label_html: true }) }}
                <a href="{{ path('app.dashboard.product.delete', { refInterne: product.refInterne }) }}" class="ui basic red button">
                    <i class="trash icon"></i>
                    Supprimer
                </a>
            </div>

            {{ form_end(form) }}
        </div>
    </div>

    <div class="ui bottom tab segment" data-tab="stock">
        {{ component('Hr', { icon: 'warehouse', text: 'Stock / Dépôt' }) }}

        <div class="ui cards">
            {% for deposit in deposits %}
                <div class="ui card">
                    <div class="content">
                        <h3 class="header">
                            {{ deposit.name }}
                        </h3>
                    </div>

                    <div class="content">
                        <p class="ui basic black label">
                            Qté. Stock --> {{ deposit.productUnits|length }}
                        </p>
                    </div>
                </div>
            {% endfor %}
        </div>

        <div class="space"></div>

        {{ component('Hr', { icon: 'box', text: 'Numéros de séries' }) }}

        <a href="{{ path('app.dashboard.product_unit.create', { productId: product.id }) }}" class="ui black button">
            <i class="plus icon"></i>
            Nouveau
        </a>

        <button class="ui basic black button searchButton">
            <i class="search icon"></i>
            Rechercher
        </button>

        <br><br>

        <div class="ui segment searchModal">
            {{ form_start(searchForm, {
                method: 'GET',
                attr: { 'data-turbo-frame': 'stock-frame' }
            }) }}
            <div class="ui form">

                <div class="four wide field">
                    {{ form_widget(searchForm.search) }}

                    {{ form_widget(searchForm.submit, {
                        label_html: true
                    }) }}
                </div>

                <input type="hidden" name="tab" id="activeTabInput">

            </div>
            {{ form_end(searchForm) }}
        </div>

        <turbo-frame id="stock-frame">

            <table class="ui celled table">
                <thead>
                <tr>
                    <th class="table-loop">#</th>
                    <th>Numéro de série</th>
                    <th>Dépôt</th>
                    <th>Prix d'achat</th>
                    <th class="table-loop"><i class="cog icon"></i></th>
                </tr>
                </thead>
                <tbody>
                {% for unit in pagination %}
                <tr data-controller="row-link" data-action="click->row-link#click" data-row-link-url-value="{{ path('app.dashboard.product_unit.update', { productUnitId: unit.id }) }}">
                    <td class="table-loop">{{ loop.index }}</td>
                    <td>{{ unit.serialNumber }}</td>
                    <td>{{ unit.deposit.name }}</td>
                    <td>{{ unit.buyPrice }} €</td>
                    <td class="table-loop">
                        <a class="ui basic red label" href="{{ path('app.dashboard.product_unit.delete', { productUnitId: unit.id }) }}">
                            Supprimer
                        </a>
                    </td>
                </tr>
                {% endfor %}
                </tbody>
            </table>

            <div class="pagination">
                {{ knp_pagination_render(pagination, 'pagination/semantic_ui_pagination.html.twig') }}
            </div>

        </turbo-frame>
    </div>



{% endblock %}
