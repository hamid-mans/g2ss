{% extends 'layouts/dashboard.base.html.twig' %}

{% block title("Espace d'administration") %}

{% block body %}
    {% for msg in app.flashes('error') %}
        {{ component('Alert', {type: 'error', text: msg}) }}
    {% endfor %}

    {% for msg in app.flashes('success') %}
        {{ component('Alert', {type: 'success', text: msg}) }}
    {% endfor %}

    <div class="ui segment">
        <h1>Liste des sociétés</h1>

        <a href="{{ path('app.dashboard.create_company') }}" class="ui basic blue button">
            <i class="plus icon"></i>
            Nouvelle société
        </a>
        <table class="ui celled table">
            <thead>
            <th class="gerer">Gérer</th>
            <th>Société</th>
            <th>Ville</th>
            </thead>
            <tbody>
            {% for company in companies %}
                <tr>
                    <td class="gerer"><a href="{{ path('app.dashboard.update_company', {id: company.id}) }}"><i class="large blue cogs icon"></i></a></td>
                    <td><b>{{ company.name }}</b></td>
                    <td>{{ company.cop ~ ' ' ~ company.city }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
