{% extends 'layouts/dashboard.base.html.twig' %}

{% block title('Modifier un utilisateur') %}

{% block body %}
    <div class="ui segment">
        <h1><i class="blue save icon"></i>Utilisateur : {{ user.lastname ~ ' ' ~ user.firstname }}</h1>
        <br>

        <div class="ui form">
            {{ form_start(userForm) }}
            <div class="two fields">
                <div class="field">
                    <label for="user_firstname">Prénom</label>
                    {{ form_row(userForm.firstname) }}
                </div>

                <div class="field">
                    <label for="user_lastname">Nom de famille</label>
                    {{ form_row(userForm.lastname) }}
                </div>
            </div>

            <div class="field">
                <label for="user_deposits">Dépôts</label>
                {{ form_widget(userForm.deposits) }}
            </div>

            <div class="two fields">
                <div class="field">
                    <label for="user_email">Email</label>
                    {{ form_row(userForm.email) }}
                </div>

                <div class="field">
                    <label for="user_password">Mot de passe</label>
                    {{ form_row(userForm.plainPassword) }}
                </div>
            </div>


            <div class="field">
                {{ component('Modal', { title: "Souhaitez-vous supprimer l'uitlisateur ?", text: "En supprimant l'utilisateur, il ne pourra plus accéder à la société.", url: path('app.dashboard.delete_user', {id: user.id}) }) }}
                {{ form_widget(userForm.submit, {label_html: true}) }} <button class="ui basic red button" type="button" onclick="$('.ui.mini.modal').modal('show')"><i class="trash icon"></i>Supprimer l'utilisateur</button>
            </div>
            {{ form_end(userForm) }}
        </div>
    </div>
{% endblock %}
