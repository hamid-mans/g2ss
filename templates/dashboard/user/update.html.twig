{% extends 'layouts/dashboard.base.html.twig' %}

{% block title('Modifier un utilisateur') %}

{% block body %}
    <div class="ui segment">
        <h1><i class="blue save icon"></i>Utilisateur : {{ user.lastname ~ ' ' ~ user.firstname }}</h1>
        <br>

        <div class="ui form">
            {{ form_start(userForm) }}
            <div class="two fields">
                <div class="field">
                    <label for="user_firstname">Prénom</label>
                    {{ form_row(userForm.firstname) }}
                </div>

                <div class="field">
                    <label for="user_lastname">Nom de famille</label>
                    {{ form_row(userForm.lastname) }}
                </div>
            </div>

            <div class="field">
                <label for="user_deposits">Dépôts</label>
                {{ form_widget(userForm.deposits) }}
            </div>

            <div class="two fields">
                <div class="field">
                    <label for="user_email">Email</label>
                    {{ form_row(userForm.email) }}
                </div>

                <div class="field">
                    <label for="user_password">Mot de passe</label>
                    {{ form_row(userForm.plainPassword) }}
                </div>
            </div>


            <div class="field">
                {{ form_row(userForm.submit, {label_html: true}) }}
            </div>
            {{ form_end(userForm) }}
        </div>
    </div>
{% endblock %}
