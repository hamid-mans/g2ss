{% extends 'layouts/dashboard.base.html.twig' %}

{% block title('Se connecter') %}

{% block body %}
        <div class="center">
            <div class="ui segment login">
                <form method="post" class="ui form">
                    {% if error %}
                        <div class="ui red message">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                    {% endif %}

                    <h1>Se connecter</h1>

                    <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

                    <div class="field">
                        <label for="inputEmail">Email</label>
                        <input type="email" value="{{ last_username }}" name="email" id="inputEmail"autocomplete="email" required autofocus>
                    </div>

                    <div class="field">
                        <label for="inputPassword">Password</label>
                        <input type="password" name="password" id="inputPassword" autocomplete="current-password" required>
                    </div>


                    <div class="field">
                        <button type="submit" class="ui basic blue button">
                            <i class="user icon"></i>
                            Se connecter
                        </button>
                    </div>
                </form>
            </div>
        </div>
{% endblock %}
