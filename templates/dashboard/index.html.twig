{% extends 'layouts/dashboard.base.html.twig' %}

{% block title('Accueil') %}

{% block topbar('Tableau de bord') %}

{% block body %}

    <div class="flex gap-10">
        <div class="card bg-base-200 border border-base-300">
            <a class="card-body" href="{{ path('app.dashboard.product.index') }}">
                <div class="flex flex-col gap-3 px-3 pr-10">
                    <div>
                        En stock
                    </div>

                    <div class="text-2xl">
                        {{ sumProducts }}
                    </div>
                </div>
            </a>
        </div>

        <div class="card bg-base-200 border border-base-300">
            <a class="card-body" href="{{ path('app.dashboard.product.index') }}">
                <div class="flex flex-col gap-3 px-3 pr-10">
                    <div>
                        Valeur totale d'achat
                    </div>

                    <div class="text-2xl">
                        {{ costProducts ~ '€' }}
                    </div>
                </div>
            </a>
        </div>
    </div>


{% endblock %}
