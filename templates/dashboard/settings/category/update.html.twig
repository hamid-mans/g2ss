{% extends 'layouts/dashboard.base.html.twig' %}

{% block title('Paramètres - Catégorie - ' ~ category.label) %}

{% block topbar %}
	<div class="breadcrumbs text-lg">
		<ul>
			<li><a href="{{ path('app.dashboard.settings.index') }}">Paramètres</a></li>
			<li><a href="{{ path('app.dashboard.settings.index', { tab: 'products' }) }}">Catégories</a></li>
			<li>{{ category.label }}</li>
		</ul>
	</div>
{% endblock %}

{% block body %}
	{{ form_start(form) }}

	<div>
		{{ form_row(form.label) }}
	</div>


	<div class="field">
		{{ form_widget(form.submit, {label_html: true}) }}
		<a href="{{ path('app.dashboard.settings.delete.category', {id: category.id}) }}" class="btn btn-error">
			<i class="ri ri-delete-bin-line"></i>
			Supprimer
		</a>
	</div>
	{{ form_end(form) }}
{% endblock %}