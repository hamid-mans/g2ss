{% extends 'layouts/dashboard.base.html.twig' %}

{% block title('Nouveau dépôt') %}

{% block body %}
    <div class="ui segment">
        <h1><i class="blue plus icon"></i>{{ company.name }} : Nouveau dépôt</h1>
        <br>

        <div class="ui form">
            {{ form_start(depositForm) }}
            <div class="field">
                <label for="deposit_name">Nom du dépôt</label>
                {{ form_row(depositForm.name) }}
            </div>

            <div class="four fields">
                <div class="field">
                    <label for="deposit_address1">Adresse 1</label>
                    {{ form_row(depositForm.address1) }}
                </div>

                <div class="field">
                    <label for="deposit_address2">Adresse 2</label>
                    {{ form_row(depositForm.address2) }}
                </div>

                <div class="field">
                    <label for="v_cop">Code Postal</label>
                    {{ form_row(depositForm.cop) }}
                </div>

                <div class="field">
                    <label for="deposit_city">Ville</label>
                    {{ form_row(depositForm.city) }}
                </div>
            </div>


            <div class="field">
                {{ form_row(depositForm.submit, {label_html: true}) }}
            </div>
            {{ form_end(depositForm) }}
        </div>
    </div>
{% endblock %}
