<div class="toast toast-end toast-top z-[100]">
	{% for type, messages in app.flashes %}
		{% for message in messages %}
			<script>
                if("{{ type }}" === 'success') {
                    Toastify({
                        text: "✔ " + {{ message|json_encode|raw }},
                        duration: 4000,
                        gravity: "top",
                        position: "center",
                        style: {
                            background: 'white',
                            color: '#333',
                            boxShadow: '0 4px 12px rgba(0,0,0,0.1)',
                            border: '1px solid #ddd',
                            // On change la bordure du haut selon le succès ou l'erreur
                            borderTop: '4px solid var(--color-success)',
                            borderRadius: '10px'
                        }
                    }).showToast();
                } else {
                    Toastify({
                        text: "❌ " + {{ message|json_encode|raw }},
                        duration: 4000,
                        gravity: "top",
                        position: "center",
                        style: {
                            background: 'white',
                            color: '#333',
                            boxShadow: '0 4px 12px rgba(0,0,0,0.1)',
                            border: '1px solid #ddd',
                            // On change la bordure du haut selon le succès ou l'erreur
                            borderTop: '4px solid var(--color-error)',
                            borderRadius: '10px'
                        }
                    }).showToast();
                }
			</script>
		{% endfor %}
	{% endfor %}
</div>

<script>
	setTimeout(() => {
        $('.toast').hide()
	}, 10000000)
</script>