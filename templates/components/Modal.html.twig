<input type="checkbox" id="{{ id }}" class="modal-toggle" />

<div class="modal modal-bottom sm:modal-middle" role="dialog">
	<div class="modal-box p-0 overflow-visible border border-white/10 bg-base-100 shadow-2xl {{ max_width|default('max-w-2xl') }}">

		{% if modalForm is defined and modalForm is not null %}
			{{ form_start(modalForm, {'attr': {'id': 'form_' ~ id }}) }}
		{% endif %}

		{# ... Header ... #}
		<div class="px-6 py-4 border-b border-base-200 bg-base-200/30">
			<h3 class="text-xl font-bold">{% block modal_title %}{% endblock %}</h3>
		</div>

		{# Body #}
		<div class="px-6 py-6">
			{% block modal_body %}{% endblock %}
		</div>

		{# Footer #}
		<div class="px-6 py-4 bg-base-200/20 border-t border-base-200 flex justify-end gap-3">
			{% block modal_footer %}{% endblock %}
		</div>

		{% if modalForm is defined and modalForm is not null %}
			{{ form_end(modalForm) }}
		{% endif %}

	</div>
	<label class="modal-backdrop bg-neutral/60 backdrop-blur-sm" for="{{ id }}">Close</label>
</div>